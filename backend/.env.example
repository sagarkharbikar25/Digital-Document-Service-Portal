# ============================================================
# JDCOEM College Portal V2 - Backend Environment Configuration
# ============================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL Pool)
DATABASE_URL=postgresql://postgres:password@localhost:5432/college_portal

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Institutional SMTP Configuration (Email Notifications & OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@institution.ac.in
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@institution.ac.in
SMTP_FROM_NAME="JDCOEM Digital Document Portal"
